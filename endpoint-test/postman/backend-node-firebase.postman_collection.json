    {
      "name": "1. Autenticación (/auth)",
      "description": "Pruebas de inicio de sesión y validación de credenciales.",
      "item": [
        {
          "name": "Login Exitoso (Admin) - Guarda Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "const token = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "",
                  "pm.test('Devuelve un token JWT válido', function () {",
                  "    pm.expect(token).to.be.a('string').and.not.be.empty;",
                  "});",
                  "",
                  "pm.test('No expone password ni passwordHash', function () {",
                  "    const raw = pm.response.text();",
                  "    pm.expect(raw).to.not.include('passwordHash');",
                  "});",
                  "",
                  "if (token) {",
                  "    const cleanToken = token.replace(/^Bearer\\s+/i, '');",
                  "    pm.environment.set('jwtToken', cleanToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Exitoso (Usuario estándar)",
          "event": [
            {
              "listen": "test",
